{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "taggerscript",
      "camelcase": "TaggerScript",
      "title": "TaggerScript",
      "scope": "source.taggerscript",
      "file-types": [
        "taggerscript",
        "ptsp",
        "picard"
      ],
      "injection-regex": "^taggerscript$",
      "class-name": "TreeSitterTaggerscript"
    }
  ],
  "metadata": {
    "version": "2026.4.10",
    "license": "UNLICENSE",
    "description": "Tree-sitter grammar for MusicBrainz Picard Tagger Script",
    "authors": [
      {
        "name": "11xx",
        "url": "https://codeberg.org/useless-utils/picard-mode"
      }
    ],
    "links": {
      "repository": "https://codeberg.org/useless-utils/picard-mode",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": false,
    "java": false,
    "node": true,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
